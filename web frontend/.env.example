# Web Frontend Environment Variables

# API Base URL - Backend server URL
# Development: http://localhost:5000
# Production: https://your-api.com
VITE_MEDITRACK_API_URL=http://localhost:5000

# Admin-dashboard API layer (falls back to the Vite dev proxy at /api/admin if unset)
VITE_API_BASE_URL=http://localhost:5000/api/admin
