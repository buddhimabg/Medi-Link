{
  "name": "medi-link",
  "version": "1.0.0",
  "description": "Medi-Link Healthcare Management Platform",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd \"web frontend\" && npm run dev",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run start:backend\" \"npm run dev:frontend\"",
    "start:backend": "cd backend && npm start",
    "build:frontend": "cd \"web frontend\" && npm run build",
    "install:all": "npm install && cd backend && npm install && cd \"../web frontend\" && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
