# Backend Environment Variables

# Server port
PORT=5000

# MongoDB connection URI
# Format: mongodb://username:password@host:port,host:port/database?options
MONGO_URI=mongodb://username:password@localhost:27017/medilink?authSource=admin

# Google Gemini API Key (required for AI journal/speech analysis)
# Get your free key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Secret used to sign/verify login JWTs (doctor-portal routes: video call, chatbot, journals)
JWT_SECRET=medilink_secret

# ZegoCloud credentials (required for video call sessions to actually connect)
# Get these from your ZegoCloud console: https://console.zegocloud.com
ZEGO_APP_ID=your_zego_app_id
ZEGO_SERVER_SECRET=your_zego_server_secret
