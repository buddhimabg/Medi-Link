# Backend Environment Variables

# Server port
PORT=5000

# MongoDB connection URI
# Format: mongodb://username:password@host:port,host:port/database?options
MONGO_URI=mongodb://username:password@localhost:27017/medilink?authSource=admin

# Google Gemini API Key (required for AI journal/speech analysis)
# Get your free key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
